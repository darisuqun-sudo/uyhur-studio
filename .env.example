# ==============================================================================
# Aqil AI Creative Platform (ئاقىل سەھنە) — مۇھىت ئۆزگەرگۈچىلىرى (Environment Variables)
# ==============================================================================
# مەزكۇر قىممەتلەرنى يەرلىك سىناق ئۈچۈن .env.local ھۆججىتىگە ساقلاڭ، ياكى Vercel / تور مۇلازىمېتىرىدا تەڭشەڭ.

# 1. OpenRouter API Key (بارلىق OpenRouter مودېللىرى ئۈچۈن)
# ئېلىش ئادرېسى: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 2. Google Gemini API Key (بىۋاسىتە Google Gemini مودېللىرى ئۈچۈن)
# ئېلىش ئادرېسى: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. سۈكۈتتىكى تور بېكەت ئاساسى ئادرېسى (تاللاش خاراكتېرلىك)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
